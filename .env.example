# Docker Compose settings (copy to .env next to docker-compose.yml; never commit real values)

# PostgreSQL
POSTGRES_DB=sentinelcore_db
POSTGRES_USER=postgres
# defaults to "postgres" when empty; set a strong value outside local dev
POSTGRES_PASSWORD=

# Host ports
FRONTEND_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432

# JWT signing key: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=

# First administrator (created only if the username does not exist; password >= 12 characters)
APP_BOOTSTRAP_ADMIN_USERNAME=secadmin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMAIL=
# Local throwaway stacks only: demo accounts with well-known passwords
APP_DEMO_USERS_ENABLED=false
APP_SELF_REGISTRATION_ENABLED=false

# Cloud security (see docs/cloud-security.md)
APP_CLOUD_AWS_ENABLED=false
APP_CLOUD_AWS_DEFAULT_REGION=us-east-1
APP_CLOUD_REMEDIATION_EXECUTION_ENABLED=false

# Frontend API base URL baked in at build time; "/api" is proxied by nginx to the backend
VITE_API_BASE_URL=/api

# Outbound proxy used by the image builds (Maven/npm) when the container network has no direct
# egress. Docker Desktop exposes its proxy as http://http.docker.internal:3128; leave empty when
# builds can reach the internet directly.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
