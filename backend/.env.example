# Backend Environment Variables (placeholders only; never commit real values)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sentinelcore_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT signing key: at least 32 random bytes, e.g. `openssl rand -base64 48`.
# If unset, an ephemeral key is generated and sessions end on every restart.
JWT_SECRET=<random-secret-at-least-32-bytes>
JWT_EXPIRATION=86400000

# CORS (comma-separated). Narrow the patterns in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# First administrator (created only if the username does not exist; password >= 12 characters)
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Local development only: creates demo accounts with well-known passwords (admin/admin123, ...)
APP_DEMO_USERS_ENABLED=false
# Public self-registration (always creates role USER)
APP_SELF_REGISTRATION_ENABLED=false

# Cloud integration (see docs/cloud-security.md). AWS credentials come from the standard AWS
# credential chain (AWS_PROFILE, instance/task role, web identity); never put access keys here.
APP_CLOUD_AWS_ENABLED=false
APP_CLOUD_AWS_DEFAULT_REGION=us-east-1
APP_CLOUD_REMEDIATION_EXECUTION_ENABLED=false
